{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deployforge.local/schemas/catalog.schema.json",
  "title": "DeployForge Application Catalog",
  "description": "Schema for declarative Windows application deployment metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "applications"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/application"
      }
    }
  },
  "$defs": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "source",
        "deployment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "package_id"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "winget",
                "msstore",
                "direct",
                "local"
              ]
            },
            "package_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "entry_point"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "powershell",
                "psadt"
              ]
            },
            "entry_point": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
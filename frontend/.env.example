# Copy to .env.local for machine-specific overrides (git-ignored via *.local).

# Base URL the browser uses for API calls.
# Empty = same origin (development with the Vite proxy below).
# Set it for builds that talk to the API directly, e.g. a desktop build:
#   VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=10000

# Development only: where the Vite dev server proxies /api and /health.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
